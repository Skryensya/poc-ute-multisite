{
  "kind": "collectionType",
  "collectionName": "careers",
  "info": { "singularName": "career", "pluralName": "careers", "displayName": "Career" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "slug": { "type": "string", "required": true, "unique": true },
    "name": { "type": "string", "required": true },
    "description": { "type": "text", "required": true },
    "overview": { "type": "text" },
    "duration": { "type": "string" },
    "degree": { "type": "string" },
    "modality": { "type": "string" },
    "imageUrl": { "type": "string" },
    "sites": { "type": "relation", "relation": "manyToMany", "target": "api::site.site" },
    "courses": { "type": "relation", "relation": "oneToMany", "target": "api::course.course", "mappedBy": "career" },
    "professors": { "type": "relation", "relation": "manyToMany", "target": "api::professor.professor", "mappedBy": "careers" }
  }
}
