{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "Announcement"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "tags": {
      "type": "json"
    },
    "slug": {
      "type": "string",
      "unique": true
    },
    "body": {
      "type": "richtext"
    },
    "author": {
      "type": "string"
    }
  }
}
